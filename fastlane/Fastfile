default_platform(:ios)

platform :ios do
  before_all do
    @api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true
    )
  end

  desc "Fetch signing certs/profile (read-only) and build a signed App Store archive"
  lane :release do
    setup_ci
    match(type: "appstore", readonly: true, api_key: @api_key)

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: "296K7JN9XW",
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_com.passormatch.app_appstore_profile-name"],
      bundle_identifier: "com.passormatch.app"
    )

    gym(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_team_id: "296K7JN9XW",
      output_directory: "build",
      output_name: "App.ipa"
    )
  end

  desc "Upload the built .ipa to TestFlight"
  lane :beta do
    UI.important("api_key present: #{!@api_key.nil?}, keys: #{@api_key.is_a?(Hash) ? @api_key.keys : @api_key.inspect}")

    upload_to_testflight(
      api_key: @api_key,
      ipa: "build/App.ipa",
      app_identifier: "com.passormatch.app",
      skip_waiting_for_build_processing: true
    )
  end
end
